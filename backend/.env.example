# Pack GPT — backend environment variables

# Server-side LLM API keys (used when the user does not supply a personal key).
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Comma-separated list of frontend origins allowed by CORS.
# Falls back to https://packgpt.vercel.app + localhost if unset.
# Example: ALLOWED_ORIGINS=https://packgpt.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=
